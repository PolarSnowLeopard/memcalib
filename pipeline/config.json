{
  "source_root": "..",
  "output_dir": "data",
  "sampling": {
    "seed": 42,
    "source_limits": {
      "OpenMed/MedDialog": 0,
      "lavita/ChatDoctor-HealthCareMagic-100k": 0
    },
    "meddialog_split_ratios": {
      "train": 0.5,
      "validation": 0.5
    },
    "balance_topics": true,
    "topic_order": [
      "acute_symptoms",
      "medication_treatment",
      "pregnancy_reproductive",
      "pediatrics",
      "chronic_disease",
      "skin_allergy",
      "digestive",
      "respiratory_ent",
      "cardio",
      "neuro",
      "mental_sleep",
      "general_other"
    ]
  },
  "api": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
    "model": "qwen3.7-max",
    "temperature": 0.2,
    "max_tokens": 8192,
    "rpm": 60,
    "max_workers": 4,
    "max_retries": 5,
    "timeout": 300
  },
  "generation": {
    "min_preferences": 3,
    "max_preferences": 8,
    "require_a_label": false,
    "require_applied_label": true,
    "recommended_patterns": [
      "AAB",
      "AAC",
      "ABC",
      "BBC",
      "AAAB",
      "AABC",
      "AAAC",
      "ABBC",
      "AACC",
      "BBCC",
      "AABBC",
      "AAABC",
      "AAACC",
      "ABBCC",
      "ABCCC",
      "BBCCC",
      "AAABBC",
      "AABBCC",
      "AAABCC",
      "AABCCC",
      "AAABBCC",
      "AABBCCC"
    ],
    "target_label_mix": {
      "A": "1-5",
      "B": "1-4",
      "C": "0-4"
    }
  },
  "split": {
    "seed": 42,
    "rl_train_size": 10000,
    "sft_size": 4000,
    "test_size": 500
  },
  "filters": {
    "min_question_chars": 40,
    "max_question_chars": 2500,
    "min_answer_chars": 30,
    "max_raw_records_per_source": 0
  },
  "raw_selection": {
    "schema_version": "crk2-raw-selection-v1",
    "scoring_version": "crk2-seed-quality-v1",
    "min_question_chars": 40,
    "max_question_chars": 2500,
    "min_answer_chars": 50,
    "max_answer_chars": 6000,
    "min_question_tokens": 8,
    "min_answer_tokens": 8,
    "min_english_letter_ratio": 0.75,
    "max_boilerplate_ratio": 0.65,
    "min_quality_score": 65,
    "near_duplicate_jaccard": 0.88,
    "topic_alpha": 0.5,
    "quality_weight_beta": 2.0,
    "complexity_targets": {
      "simple": 0.25,
      "medium": 0.5,
      "complex": 0.25
    }
  }
}
